# # Generate one with: openssl rand -base64 32
# NEXTAUTH_SECRET=CHANGE_ME_DIFFERENT_FROM_ERP_SECRET
# AUTH_SECRET=CHANGE_ME_DIFFERENT_FROM_ERP_SECRET




